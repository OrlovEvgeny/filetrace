#!/sbin/openrc-run
# shellcheck shell=sh disable=SC2034

description="Filetrace agent"
supervisor=supervise-daemon
command=@bindir@/filetrace-agent
command_args="${FILETRACE_AGENT_OPTS:-}"
output_log=/var/log/filetrace-agent.log
error_log=/var/log/filetrace-agent.log
respawn_delay=5
respawn_max=5
respawn_period=300

depend()
{
    need localmount
    after bootmisc logger
}

start_pre()
{
    if [ ! -e /sys/kernel/btf/vmlinux ]; then
        eerror "This kernel has no BTF (/sys/kernel/btf/vmlinux), which filetrace-agent needs"
        return 1
    fi
    @bindir@/filetrace config validate >/dev/null || return 1
    checkpath --directory --mode 0755 --owner root:root /run/filetrace
}
