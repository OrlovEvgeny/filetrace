[Unit]
Description=Filetrace agent
Documentation=https://filetrace.eorlov.org https://github.com/OrlovEvgeny/filetrace
ConditionPathExists=/sys/kernel/btf/vmlinux
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecStart=@bindir@/filetrace-agent
Restart=on-failure
RestartSec=5
# Invalid arguments, missing privileges, an unsupported kernel and a broken
# configuration file do not go away on a retry.
RestartPreventExitStatus=2 3 5 6
TimeoutStopSec=15

RuntimeDirectory=filetrace
RuntimeDirectoryMode=0755

# CAP_SYS_PTRACE reads /proc/<pid>/exe and the namespaces of other users' processes.
CapabilityBoundingSet=CAP_BPF CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_PTRACE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
